APP_NAME="Martin Sols HUB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

CRM_API_DEBUG=false
CRM_TRUST_LARAVEL_SESSION=true
CRM_ALLOW_LEGACY_ACTOR_IMPERSONATION=false
CRM_ALLOW_LEGACY_ACTOR_HEADER=false
CRM_ALLOW_LEGACY_ACTOR_BODY=false
CRM_FORCE_HTTPS=false
CRM_HSTS_ENABLED=false
CRM_HSTS_MAX_AGE=31536000
CRM_HSTS_INCLUDE_SUBDOMAINS=true
CRM_HSTS_PRELOAD=true
CRM_SECURITY_HEADERS_ENABLED=true
CRM_SECURITY_FRAME_OPTIONS=DENY
CRM_SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
CRM_SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
CRM_SECURITY_CSP_ENABLED=true
CRM_SECURITY_CSP_REPORT_ONLY=true
CRM_SECURITY_CSP="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; img-src 'self' data: blob:; font-src 'self' data: https://fonts.bunny.net; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
CRM_TRUSTED_PROXIES=REMOTE_ADDR
CRM_TRUSTED_HOSTS=crm.jp2.fr
CRM_TRUSTED_HOST_SUBDOMAINS=true
CRM_API_THROTTLE_PER_MINUTE=120
CRM_API_THROTTLE_ADMIN_PER_MINUTE=200
CRM_API_THROTTLE_RESPONSABLE_PER_MINUTE=100
CRM_API_THROTTLE_MANAGER_PER_MINUTE=100
CRM_API_THROTTLE_USER_PER_MINUTE=80
CRM_API_THROTTLE_EMPLOYEE_PER_MINUTE=60
CRM_API_THROTTLE_BLOCKED_PER_MINUTE=30
CRM_API_THROTTLE_GUEST_PER_MINUTE=60
CRM_LOGIN_THROTTLE_PER_MINUTE=10
CRM_RESPONSE_COMPRESSION_ENABLED=true
CRM_RESPONSE_COMPRESSION_MIN_BYTES=1024
CRM_RESPONSE_COMPRESSION_LEVEL=6
CRM_BACKUP_DISK=local
CRM_BACKUP_PATH=backups/database
CRM_BACKUP_KEEP=14
CRM_BACKUP_KEEP_WEEKLY=8
CRM_BACKUP_KEEP_MONTHLY=12
CRM_BACKUP_DUMP_BINARY=
CRM_BACKUP_DUMP_OPTIONS=
CRM_BACKUP_GZIP_LEVEL=6
CRM_BACKUP_TIMEOUT_SECONDS=0
CRM_BACKUP_VERIFY=true
CRM_BACKUP_ENCRYPT=false
CRM_BACKUP_ENCRYPTION_KEY=
CRM_ARCHIVE_RETENTION_YEARS=2
CRM_ARCHIVE_BATCH_SIZE=500
CRM_ARCHIVE_RESERVATIONS_RETENTION_YEARS=2
CRM_ARCHIVE_EQUIPMENT_RENTALS_RETENTION_YEARS=2
CRM_ARCHIVE_LEAVES_RETENTION_YEARS=1
CRM_ARCHIVE_CASH_DAYS_RETENTION_YEARS=3
CRM_ARCHIVE_CHECK_REMITTANCES_RETENTION_YEARS=3
CRM_ARCHIVE_DEPOSIT_REQUESTS_RETENTION_YEARS=3
CRM_ARCHIVE_SALES_TOURS_RETENTION_YEARS=5
CRM_LEAVE_DEFAULT_ENTITLEMENT_DAYS=25
CRM_LEAVE_EXCLUDE_WEEKENDS=false
CRM_LEAVE_ENFORCE_BALANCES=false
CRM_DASHBOARD_METRICS_ENABLED=true
CRM_QUEUE_ALERT_THRESHOLD=1000
CRM_QUEUE_ALERT_COOLDOWN_MINUTES=30
CRM_CASH_RECEIPT_ARCHIVE_AFTER_YEARS=3
CRM_INVOICE_REMINDER_DAYS=15,30
CRM_NOTIFICATION_LOCALE=fr
CRM_NOTIFICATION_CHANNELS=database,mail,pwa
CRM_AUDIT_ENABLED=true
ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_DELETE_OLDER_THAN_DAYS=365
ACTIVITY_LOGGER_DEFAULT_LOG_NAME=crm
CRM_ADMIN_PASSWORD_MIN=12
CRM_ADMIN_HASH_ROUNDS=12
CRM_ASSET_VERSION=local
CRM_CHECK_OCR_ENABLED=true
CRM_CHECK_OCR_PYTHON=python3
CRM_CHECK_OCR_SCRIPT=
CRM_CHECK_OCR_TIMEOUT=45
CORS_ALLOWED_ORIGINS=https://crm.jp2.fr,capacitor://localhost,ionic://localhost,http://localhost,http://localhost:8100

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC
CRM_DISPLAY_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
